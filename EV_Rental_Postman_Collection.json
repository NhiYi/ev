{
  "info": {
    "name": "EV Rental Microservices",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Rental Service",
      "item": [
        {
          "name": "Create Rental",
          "request": {
            "method": "POST",
            "url": "{{rental_url}}/api/rental/create",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"123\",\n  \"vehicleId\": \"V001\",\n  \"stationId\": \"S01\"\n}"
            }
          }
        },
        {
          "name": "Checkin",
          "request": {
            "method": "POST",
            "url": "{{rental_url}}/api/rental/checkin",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rentalId\": \"R001\"\n}"
            }
          }
        },
        {
          "name": "Checkout",
          "request": {
            "method": "POST",
            "url": "{{rental_url}}/api/rental/checkout",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rentalId\": \"R001\"\n}"
            }
          }
        },
        {
          "name": "History",
          "request": {
            "method": "GET",
            "url": "{{rental_url}}/api/rental/history?userId=123"
          }
        },
        {
          "name": "Rental Detail",
          "request": {
            "method": "GET",
            "url": "{{rental_url}}/api/rental/detail/:id"
          }
        }
      ]
    },
    {
      "name": "Station Service",
      "item": [
        {
          "name": "Get All Stations",
          "request": {
            "method": "GET",
            "url": "{{station_url}}/api/station/"
          }
        },
        {
          "name": "Get Station Detail",
          "request": {
            "method": "GET",
            "url": "{{station_url}}/api/station/:id"
          }
        },
        {
          "name": "Get Station Vehicles",
          "request": {
            "method": "GET",
            "url": "{{station_url}}/api/station/:id/vehicles"
          }
        },
        {
          "name": "Get Vehicle Detail",
          "request": {
            "method": "GET",
            "url": "{{station_url}}/api/station/:id/vehicle/:vehicleId"
          }
        }
      ]
    },
    {
      "name": "Payment Service",
      "item": [
        {
          "name": "Create Payment",
          "request": {
            "method": "POST",
            "url": "{{payment_url}}/api/payment/create",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rentalId\": \"R001\",\n  \"amount\": 10000\n}"
            }
          }
        },
        {
          "name": "Confirm Payment",
          "request": {
            "method": "POST",
            "url": "{{payment_url}}/api/payment/confirm",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentId\": \"P001\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Analytics Service",
      "item": [
        {
          "name": "Send Event",
          "request": {
            "method": "POST",
            "url": "{{analytics_url}}/api/analytics/event",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"rental_created\",\n  \"userId\": \"123\"\n}"
            }
          }
        },
        {
          "name": "Usage Report",
          "request": {
            "method": "GET",
            "url": "{{analytics_url}}/api/analytics/report/usage"
          }
        },
        {
          "name": "Revenue Report",
          "request": {
            "method": "GET",
            "url": "{{analytics_url}}/api/analytics/report/revenue"
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "rental_url", "value": "http://localhost:5004" },
    { "key": "station_url", "value": "http://localhost:5010" },
    { "key": "payment_url", "value": "http://localhost:5005" },
    { "key": "analytics_url", "value": "http://localhost:4004" }
  ]
}
